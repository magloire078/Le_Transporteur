rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/utilisateurs/$(request.auth.uid))
        && get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data.role == 'admin';
    }

    function vehicle(vehicleId) {
      return get(/databases/$(database)/documents/vehicules/$(vehicleId)).data;
    }

    function ownsVehicle(vehicleId) {
      return isAuthenticated() && vehicle(vehicleId).ownerId == request.auth.uid;
    }

    function drivesVehicle(vehicleId) {
      return isAuthenticated()
        && (vehicle(vehicleId).primaryDriverId == request.auth.uid
            || vehicle(vehicleId).secondaryDriverId == request.auth.uid);
    }

    match /utilisateurs/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // À l'inscription, on ne peut pas s'attribuer le rôle admin.
      allow create: if isOwner(userId) && request.resource.data.role in ['owner', 'driver'];
      // Le rôle ne peut pas être modifié par l'utilisateur lui-même.
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    match /proprietaires/{ownerId} {
      allow read, write: if isOwner(ownerId) || isAdmin();
    }

    match /chauffeurs/{driverId} {
      allow list, get: if isAuthenticated();
      allow create: if isAuthenticated();
      // Le chauffeur lui-même, le propriétaire qui a créé la fiche, ou un admin.
      allow update: if isOwner(driverId)
        || (isAuthenticated() && resource.data.get('createdBy', '') == request.auth.uid)
        || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.get('createdBy', '') == request.auth.uid) || isAdmin();
    }

    match /gerants/{managerId} {
      allow read: if isAuthenticated();
    }

    match /vehicules/{vehicleId} {
      allow list, get: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.ownerId == request.auth.uid
                          && request.resource.data.ownerId == resource.data.ownerId)
        || isAdmin()
        // Un chauffeur affecté peut seulement changer le statut du véhicule.
        || ((resource.data.primaryDriverId == request.auth.uid || resource.data.secondaryDriverId == request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    // revenus/{vehicleId} : un document par véhicule (id = id du véhicule).
    match /revenus/{vehicleId} {
      allow read: if ownsVehicle(vehicleId) || drivesVehicle(vehicleId) || isAdmin();
      allow create, update: if ownsVehicle(vehicleId) || isAdmin();
      allow delete: if ownsVehicle(vehicleId) || isAdmin();

      // Le chauffeur affecté peut uniquement ajouter UNE transaction (son versement).
      allow create: if drivesVehicle(vehicleId)
        && request.resource.data.transactions.size() == 1;
      allow update: if drivesVehicle(vehicleId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['transactions', 'vehicleId'])
        && request.resource.data.transactions.size() == resource.data.transactions.size() + 1;
    }
  }
}
